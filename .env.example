# Public Supabase project URL and publishable key (never a service_role key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact trusted origin. Use http://localhost:3000 for local OAuth testing.
SITE_URL=https://tredmeal.com
# Explicit first-party alias; preserve existing passkeys and sessions.
SITE_URL_ALIASES=https://iamable.space
# Local visual demo only. Always false on Vercel; VERCEL=1 also blocks this route.
ENABLE_DEMO=false
# Server only. Never use NEXT_PUBLIC_ for this key. Obtain access from Instacart.
INSTACART_API_KEY=
# Explicitly choose development or production; production requires a production key.
INSTACART_ENVIRONMENT=development
